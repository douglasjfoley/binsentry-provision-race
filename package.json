{
  "name": "race-the-route",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Race the Route: BinSentry ProVision booth game",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "solve": "node tools/solve.ts",
    "harness": "node tools/harness.ts",
    "replay": "node tools/replay.ts",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
